@model List<QL_WebBanTraSua.Models.CartItem>

@{
    ViewBag.Title = "Thanh Toán & Đặt Hàng";
    Layout = "~/Views/Shared/LayoutKhachHang.cshtml";

    decimal subtotal = ViewBag.Subtotal != null ? (decimal)ViewBag.Subtotal : 0m;
    decimal shipping = ViewBag.ShippingFee != null ? (decimal)ViewBag.ShippingFee : 15000m;
    decimal discount = ViewBag.Discount != null ? (decimal)ViewBag.Discount : 0m;
    decimal total = ViewBag.FinalTotal != null ? (decimal)ViewBag.FinalTotal : 0m;
    var appliedVoucher = ViewBag.AppliedVoucher as QL_WebBanTraSua.Models.voucher;

    string customerPhone = Session["CustomerPhone"] as string ?? "";
}

<main class="container py-5 mt-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Customer")" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Cart", "Customer")" class="text-decoration-none text-muted">Giỏ hàng</a></li>
            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">Thanh toán</li>
        </ol>
    </nav>

    @if (TempData["VoucherError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["VoucherError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["VoucherSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["VoucherSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["CheckoutError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["CheckoutError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5">
        <!-- Cột trái: Form thông tin -->
        <div class="col-lg-7">
            @using (Html.BeginForm("DatHang", "Customer", FormMethod.Post, new { id = "checkout-form" }))
            {
                @Html.AntiForgeryToken()

                <h4 class="text-uppercase fw-bold mb-3 text-dark">
                    <i class="bi bi-person-lines-fill me-2 text-primary"></i>1. Thông Tin Nhận Hàng
                </h4>
                <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label text-muted small fw-semibold">Họ và tên người nhận <span class="text-danger">*</span></label>
                            <input type="text"
                                   name="shipping_name"
                                   class="form-control rounded-3 py-2"
                                   placeholder="Ví dụ: Nguyễn Hoàng Bảo"
                                   value="@(Session["CustomerName"] as string ?? "")"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                            <input type="tel"
                                   name="shipping_phone"
                                   class="form-control rounded-3 py-2"
                                   placeholder="Ví dụ: 0359490221"
                                   value="@customerPhone"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Email nhận hóa đơn</label>
                            <input type="email"
                                   name="shipping_email"
                                   class="form-control rounded-3 py-2"
                                   placeholder="name@example.com"
                                   value="@(Session["CustomerEmail"] as string ?? "")" />
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small fw-semibold">Địa chỉ giao hàng chi tiết <span class="text-danger">*</span></label>
                            <input type="text"
                                   name="shipping_address"
                                   class="form-control rounded-3 py-2"
                                   placeholder="Ví dụ: 140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP. HCM"
                                   value="@(Session["CustomerAddress"] as string ?? "")"
                                   required />
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small fw-semibold">Ghi chú cho quán (Tùy chọn)</label>
                            <textarea name="checkout_note"
                                      class="form-control rounded-3"
                                      rows="2"
                                      placeholder="Ví dụ: Tới nơi gọi trước 5 phút, giao ở cổng trường...">@(Session["CustomerNote"] as string ?? "")</textarea>
                        </div>
                    </div>
                </div>

                <h4 class="text-uppercase fw-bold mb-3 text-dark">
                    <i class="bi bi-wallet-fill me-2 text-primary"></i>2. Phương Thức Thanh Toán
                </h4>
                <div class="bg-white p-4 rounded-4 border shadow-sm mb-4">
                    <div class="form-check mb-3 p-3 border rounded-3 d-flex align-items-center bg-light">
                        <input class="form-check-input ms-0 me-3 fs-5"
                               type="radio"
                               name="payment_method"
                               id="paymentCash"
                               value="cash"
                               checked />
                        <label class="form-check-label w-100 fw-semibold cursor-pointer" for="paymentCash">
                            <i class="bi bi-cash-stack text-success fs-4 me-2"></i> Thanh toán tiền mặt khi nhận hàng (COD)
                        </label>
                    </div>

                    <div class="form-check mb-3 p-3 border rounded-3 d-flex align-items-center bg-light">
                        <input class="form-check-input ms-0 me-3 fs-5"
                               type="radio"
                               name="payment_method"
                               id="paymentTransfer"
                               value="transfer" />
                        <label class="form-check-label w-100 fw-semibold cursor-pointer" for="paymentTransfer">
                            <i class="bi bi-qr-code text-primary fs-4 me-2"></i> Chuyển khoản ngân hàng (VietQR)
                        </label>
                    </div>

                    <div class="form-check p-3 border rounded-3 d-flex align-items-center bg-light">
                        <input class="form-check-input ms-0 me-3 fs-5"
                               type="radio"
                               name="payment_method"
                               id="paymentMomo"
                               value="momo" />
                        <label class="form-check-label w-100 fw-semibold cursor-pointer" for="paymentMomo">
                            <i class="bi bi-wallet2 text-danger fs-4 me-2"></i> Ví điện tử MoMo
                        </label>
                    </div>
                </div>
            }
        </div>

        <!-- Cột phải: Đơn hàng tóm tắt & Voucher -->
        <div class="col-lg-5">
            <div class="bg-white p-4 rounded-4 border shadow-sm sticky-top" style="top: 85px;">
                <h5 class="text-uppercase fw-bold mb-3 border-bottom pb-3 text-dark">
                    <i class="bi bi-receipt me-2 text-primary"></i>Đơn Hàng (@Model.Sum(i => i.Quantity) món)
                </h5>

                <div class="mb-3 overflow-auto pe-1" style="max-height: 280px;">
                    @foreach (var item in Model)
                    {
                        <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-2">
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">@item.ProductName</h6>
                                <p class="text-muted small mb-0">
                                    Size @item.Size, Đường @(item.SugarLevel)%, Đá @(item.IceOption)
                                </p>
                                @if (item.Toppings != null && item.Toppings.Any())
                                {
                                    <p class="text-primary small mb-0">
                                        + @string.Join(", ", item.Toppings.Select(t => t.Name))
                                    </p>
                                }
                                <span class="badge bg-secondary">SL: @item.Quantity</span>
                            </div>
                            <span class="fw-bold text-dark">@string.Format("{0:N0}₫", item.TotalPrice)</span>
                        </div>
                    }
                </div>

                <!-- Form áp dụng Voucher -->
                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold">Mã khuyến mãi / Voucher</label>
                    @using (Html.BeginForm("ApDungVoucher", "Customer", FormMethod.Post, new { @class = "input-group", id = "voucher-form" }))
                    {
                        <input type="hidden" name="shipping_name" id="v_shipping_name" />
                        <input type="hidden" name="shipping_phone" id="v_shipping_phone" />
                        <input type="hidden" name="shipping_email" id="v_shipping_email" />
                        <input type="hidden" name="shipping_address" id="v_shipping_address" />
                        <input type="hidden" name="checkout_note" id="v_checkout_note" />
                        <input type="text"
                               name="voucherCode"
                               class="form-control"
                               placeholder="Ví dụ: TET2026, CHAO2026..."
                               value="@(appliedVoucher != null ? appliedVoucher.code : "")"
                               @(appliedVoucher != null ? "readonly" : "") />
                        if (appliedVoucher != null)
                        {
                            <a href="@Url.Action("HuyVoucher", "Customer")" class="btn btn-outline-danger" type="button">Hủy</a>
                        }
                        else
                        {
                            <button class="btn btn-primary fw-bold" type="submit">Áp dụng</button>
                        }
                    }
                    @if (appliedVoucher != null)
                    {
                        <div class="small text-success mt-1">
                            <i class="bi bi-tag-fill me-1"></i>Đã áp dụng mã <strong>@appliedVoucher.code</strong>: @appliedVoucher.name
                        </div>
                    }
                </div>

                <div class="border-top pt-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold">@string.Format("{0:N0}₫", subtotal)</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí giao hàng:</span>
                        <span class="fw-bold text-success">@string.Format("{0:N0}₫", shipping)</span>
                    </div>

                    @if (discount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Giảm giá Voucher:</span>
                            <span class="fw-bold">-@string.Format("{0:N0}₫", discount)</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-4 border-top pt-3">
                        <span class="text-dark fw-bold fs-5">Tổng thanh toán:</span>
                        <span class="fw-bolder fs-3 text-primary">@string.Format("{0:N0}₫", total)</span>
                    </div>

                    <button type="submit"
                            form="checkout-form"
                            class="btn btn-primary w-100 py-3 rounded-pill text-uppercase fw-bold fs-6 shadow">
                        <i class="bi bi-bag-check-fill me-2"></i>Xác Nhận Đặt Hàng Ngay
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>


@section scripts {
<script>
    document.getElementById('voucher-form')?.addEventListener('submit', function () {
        var nameInput = document.querySelector('input[name="shipping_name"]');
        var phoneInput = document.querySelector('input[name="shipping_phone"]');
        var emailInput = document.querySelector('input[name="shipping_email"]');
        var addrInput = document.querySelector('input[name="shipping_address"]');
        var noteInput = document.querySelector('textarea[name="checkout_note"]');

        if (nameInput) document.getElementById('v_shipping_name').value = nameInput.value;
        if (phoneInput) document.getElementById('v_shipping_phone').value = phoneInput.value;
        if (emailInput) document.getElementById('v_shipping_email').value = emailInput.value;
        if (addrInput) document.getElementById('v_shipping_address').value = addrInput.value;
        if (noteInput) document.getElementById('v_checkout_note').value = noteInput.value;
    });
</script>
}
