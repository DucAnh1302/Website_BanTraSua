@model List<QL_WebBanTraSua.Models.order>

@{
    ViewBag.Title = "Lịch Sử Đơn Hàng & Hóa Đơn";
    Layout = "~/Views/Shared/LayoutKhachHang.cshtml";

    string currentPhone = ViewBag.Phone as string ?? Session["CustomerPhone"] as string ?? "";
}

<main class="container py-5 mt-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Customer")" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">Lịch sử đơn hàng</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="bg-white p-4 rounded-4 border shadow-sm text-center mb-4">
                <div class="display-3 text-primary mb-2">
                    <i class="bi bi-person-circle"></i>
                </div>
                <h4 class="fw-bold mb-1 text-dark">Khách Hàng Thân Thiết</h4>
                <p class="text-muted small mb-3">Thành viên Tiệm Trà Sữa</p>
                <hr class="opacity-50" />

                <form action="@Url.Action("OrderHistory", "Customer")" method="GET" class="text-start">
                    <label class="form-label small fw-semibold text-muted">Tra cứu theo SĐT hoặc mã đơn:</label>
                    <div class="input-group mb-2">
                        <input type="text"
                               name="phone"
                               class="form-control"
                               placeholder="Ví dụ: 0359... hoặc #32"
                               value="@currentPhone"
                               required />
                        <button type="submit" class="btn btn-primary fw-bold">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <small class="text-muted">Nhập số điện thoại đặt hàng hoặc mã đơn (#ID) để tra cứu.</small>
                </form>
            </div>

            <div class="bg-white p-4 rounded-4 border shadow-sm">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-headset me-2 text-primary"></i>Cần Hỗ Trợ Đơn Hàng?</h6>
                <p class="small text-muted mb-2">Nếu cần hủy đơn hoặc điều chỉnh địa chỉ giao, hãy liên hệ ngay:</p>
                <p class="fw-bold text-primary mb-0"><i class="bi bi-telephone-fill me-1"></i> Hotline: 1900 1234</p>
            </div>
        </div>

        <div class="col-md-8">
            <div class="bg-white p-4 rounded-4 border shadow-sm">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <h4 class="fw-bold text-uppercase fs-5 mb-0 text-dark">
                        <i class="bi bi-clock-history me-2 text-primary"></i>Lịch Sử Giao Dịch (@(Model != null ? Model.Count : 0) đơn)
                    </h4>
                    @if (!string.IsNullOrEmpty(currentPhone))
                    {
                        <span class="badge bg-light text-dark border">SĐT: @currentPhone</span>
                    }
                </div>

                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-bag-x display-3 mb-3 d-block text-muted"></i>
                        <h5 class="fw-bold text-secondary">Chưa tìm thấy đơn hàng nào</h5>
                        <p class="text-muted small">Bạn chưa có đơn đặt hàng nào hoặc hãy thử nhập số điện thoại khác.</p>
                        <a href="@Url.Action("Products", "Customer")" class="btn btn-outline-primary rounded-pill fw-bold px-4 mt-2">
                            Đặt Trà Sữa Ngay
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var ord in Model)
                        {
                            string badgeClass = "bg-warning text-dark";
                            string statusText = "Đang xử lý (Chờ xác nhận)";
                            if (ord.order_status == "completed") { badgeClass = "bg-success text-white"; statusText = "Đã hoàn thành"; }
                            else if (ord.order_status == "shipping") { badgeClass = "bg-info text-dark"; statusText = "Đang giao hàng"; }
                            else if (ord.order_status == "preparing") { badgeClass = "bg-primary text-white"; statusText = "Đang pha chế"; }
                            else if (ord.order_status == "cancelled") { badgeClass = "bg-danger text-white"; statusText = "Đã hủy"; }

                            <div class="p-3 bg-light rounded-4 border">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div>
                                        <strong class="text-primary me-2 fs-6">#@ord.id</strong>
                                        <span class="text-muted small">
                                            <i class="bi bi-calendar3 me-1"></i>@(ord.created_at.HasValue ? ord.created_at.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                        </span>
                                    </div>
                                    <span class="badge @badgeClass rounded-pill px-3 py-2">
                                        @statusText
                                    </span>
                                </div>

                                <div class="mb-3 ps-2">
                                    @if (ord.order_items != null && ord.order_items.Any())
                                    {
                                        foreach (var itm in ord.order_items)
                                        {
                                            var v = itm.product_variants;
                                            string pName = v != null && v.product != null ? v.product.name : "Thức uống";
                                            string pSize = v != null ? v.size : "M";
                                            string topStr = "";
                                            if (itm.order_item_toppings != null && itm.order_item_toppings.Any())
                                            {
                                                topStr = " (+ " + string.Join(", ", itm.order_item_toppings.Select(t => t.topping_name)) + ")";
                                            }

                                            <div class="small text-dark mb-1">
                                                • <strong>@pName</strong> (x@itm.quantity) - Size @pSize, Đường @(itm.sugar_level)%, Đá @(itm.ice_option)
                                                <span class="text-primary fw-semibold">@topStr</span>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pt-2 border-top gap-2">
                                    <div>
                                        <span class="text-muted small">Tổng thanh toán:</span>
                                        <strong class="text-primary fs-5 ms-1">@string.Format("{0:N0}₫", ord.final_total)</strong>
                                        <span class="badge bg-light text-secondary border ms-2">
                                            @(ord.payment_method == "transfer" ? "Chuyển khoản" : "Tiền mặt")
                                        </span>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("OrderDetail", "Customer", new { id = ord.id })"
                                           class="btn btn-sm btn-outline-dark rounded-pill fw-semibold px-3">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>

                                        <a href="@Url.Action("XuatHoaDonPDF", "Customer", new { id = ord.id })"
                                           target="_blank"
                                           class="btn btn-sm btn-danger rounded-pill fw-bold px-3 shadow-sm">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i>Xuất PDF
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</main>
