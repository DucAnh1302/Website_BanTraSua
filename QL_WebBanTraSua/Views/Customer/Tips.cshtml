@{
    ViewBag.Title = "Cẩm Nang Thưởng Thức Trà - Tiệm Trà Sữa";
    Layout = "~/Views/Shared/LayoutKhachHang.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/assets/css/tips.css")" />
    <style>
        .hover-lift {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
        }
        .topping-img {
            height: 190px;
            object-fit: cover;
            width: 100%;
            border-radius: 12px 12px 0 0;
        }
        .season-img-wrap img {
            height: 220px;
            object-fit: cover;
            width: 100%;
        }
        .tip-number {
            font-size: 2rem;
            font-weight: 800;
            color: #d4a373;
            line-height: 1;
        }
    </style>
}

<main class="bg-light text-dark">
    <!-- 1. HERO BANNER -->
    <section class="tips-hero-section d-flex align-items-center justify-content-center text-center position-relative w-100 overflow-hidden"
             style="min-height: 380px; background: url('https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=1920&auto=format&fit=crop') center/cover no-repeat;">
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(18, 18, 18, 0.7);"></div>
        
        <div class="container position-relative py-5" style="z-index: 2;">
            <p class="text-uppercase text-white-50 fw-semibold small tracking-wide mb-2">Kiến thức thưởng trà</p>
            <h1 class="display-4 fw-bolder text-uppercase mb-3 text-white" style="letter-spacing: 2px;">
                Cẩm Nang Thưởng Trà
            </h1>
            <p class="fs-6 text-light mx-auto mb-0" style="max-width: 600px; opacity: 0.9;">
                Công thức chọn tỉ lệ đường đá, gợi ý kết hợp topping và cách thưởng thức trọn vị.
            </p>
        </div>
    </section>

    <!-- 2. HƯỚNG DẪN CHỌN ĐƯỜNG & ĐÁ -->
    <section class="py-5">
        <div class="container py-4">
            <div class="row align-items-center mb-5 pb-4 border-bottom border-light-subtle">
                <div class="col-lg-6 pe-lg-5 mb-4 mb-lg-0">
                    <span class="text-muted fw-bold text-uppercase small">Công thức gợi ý</span>
                    <h2 class="fw-bold text-dark text-uppercase mt-1 mb-3">Tỉ Lệ Đường & Đá</h2>
                    <p class="text-muted lh-lg mb-3">
                        Độ ngọt và nhiệt độ đóng vai trò quyết định đến hương thơm của lá trà. Để cảm nhận trọn vẹn vị mộc tự nhiên mà không bị gắt hay nhạt vị, bạn có thể tham khảo bảng gợi ý dưới đây.
                    </p>
                    
                    <div class="p-3 mb-3 bg-white rounded-3 border">
                        <div class="fw-bold text-dark mb-1">Tỉ lệ khuyên dùng: 70% Đường • 50% Đá</div>
                        <div class="text-muted small">Vị ngọt thanh dịu, giữ trọn hậu vị trà Oolong và Trà lài ngay cả khi đá tan dần.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <h6 class="fw-bold text-dark mb-1">100% Đường - 100% Đá</h6>
                            <p class="text-muted small mb-0">Ngọt đậm đà, giải khát tức thì ngày nắng nóng.</p>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="fw-bold text-dark mb-1">30% Đường - Ít/Không Đá</h6>
                            <p class="text-muted small mb-0">Hạn chế đường, đậm đà vị trà nguyên bản.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="table-responsive shadow-sm rounded-3 overflow-hidden border">
                        <table class="table table-white table-hover text-center align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col" class="py-3 text-uppercase small">Mức Đường</th>
                                    <th scope="col" class="py-3 text-uppercase small">Mức Đá</th>
                                    <th scope="col" class="py-3 text-uppercase small">Cảm Nhận Vị Giác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold py-3">100%</td>
                                    <td>100%</td>
                                    <td class="text-muted small">Đậm đà, mát lạnh sảng khoái</td>
                                </tr>
                                <tr class="table-light fw-semibold">
                                    <td class="py-3 text-primary fw-bold">70%</td>
                                    <td class="text-primary fw-bold">50%</td>
                                    <td class="small">Cân bằng tinh tế (Khuyên chọn)</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold py-3">50%</td>
                                    <td>50%</td>
                                    <td class="text-muted small">Ngọt dịu nhẹ, rõ mùi lá trà</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold py-3">30%</td>
                                    <td>30% hoặc 0%</td>
                                    <td class="text-muted small">Vị chát thanh tự nhiên, ít ngọt</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. TOPPING GỢI Ý -->
    <section class="py-5 bg-white border-top border-bottom border-light-subtle">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="text-muted fw-bold text-uppercase small">Gợi ý Topping</span>
                <h2 class="fw-bold text-dark text-uppercase mt-1">Kết Hợp Cùng Topping</h2>
                <p class="text-muted small">Chọn đúng topping để tôn thêm độ ngon cho từng dòng thức uống</p>
            </div>

            <div class="row g-4">
                <!-- Topping 1 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-light">
                        <img src="https://images.unsplash.com/photo-1541658016709-82535e94bc69?q=80&w=600&auto=format&fit=crop"
                             class="topping-img" alt="Trân châu hoàng kim">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark mb-1">Trân Châu Hoàng Kim</h6>
                            <p class="text-muted small mb-2">Ủ mật ong và đường nâu, dẻo dai từng hạt.</p>
                            <span class="text-muted small d-block">Hợp với: Trà Sữa Truyền Thống, Hồng Trà</span>
                        </div>
                    </div>
                </div>

                <!-- Topping 2 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-light">
                        <img src="https://images.unsplash.com/photo-1572490122747-3968b75cc699?q=80&w=600&auto=format&fit=crop"
                             class="topping-img" alt="Kem Cheese Macchiato">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark mb-1">Kem Cheese Macchiato</h6>
                            <p class="text-muted small mb-2">Lớp bọt sữa phô mai mặn béo phủ trên mặt ly.</p>
                            <span class="text-muted small d-block">Hợp với: Matcha Latte, Oolong Nướng</span>
                        </div>
                    </div>
                </div>

                <!-- Topping 3 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-light">
                        <img src="https://images.unsplash.com/photo-1556679343-c7306c1976bc?q=80&w=600&auto=format&fit=crop"
                             class="topping-img" alt="Nha đam và đào giòn">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark mb-1">Nha Đam & Đào Giòn</h6>
                            <p class="text-muted small mb-2">Giòn sần sật thanh mát, giải nhiệt dễ chịu.</p>
                            <span class="text-muted small d-block">Hợp với: Trà Đào Cam Sả, Trà Vải</span>
                        </div>
                    </div>
                </div>

                <!-- Topping 4 -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-light">
                        <img src="https://images.unsplash.com/photo-1517701604599-bb29b565090c?q=80&w=600&auto=format&fit=crop"
                             class="topping-img" alt="Pudding trứng">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark mb-1">Pudding Trứng Gà</h6>
                            <p class="text-muted small mb-2">Mềm mịn thơm ngậy, tan nhẹ trên đầu lưỡi.</p>
                            <span class="text-muted small d-block">Hợp với: Trà Khoai Môn, Cacao Sữa</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. BỘ SƯU TẬP THEO MÙA -->
    <section class="py-5">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="text-muted fw-bold text-uppercase small">Bộ sưu tập</span>
                <h2 class="fw-bold text-dark text-uppercase mt-1">Hương Vị Theo Mùa</h2>
                <p class="text-muted small">Những sự kết hợp độc đáo được phục vụ theo từng thời điểm trong năm</p>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-white">
                        <div class="season-img-wrap">
                            <img src="https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?q=80&w=800&auto=format&fit=crop"
                                 alt="Trà trái cây nhiệt đới" />
                        </div>
                        <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Mùa Hè</span>
                                <h5 class="fw-bold mb-2">Trái Cây Nhiệt Đới</h5>
                                <p class="text-muted small mb-3">
                                    Hồng trà kết hợp đào tươi, dâu tây và chanh mọng nước thanh mát cho ngày nắng.
                                </p>
                            </div>
                            <div class="pt-2 border-top">
                                <a href="@Url.Action("Products", "Customer", new { categoryId = 2 })" class="text-primary fw-semibold small text-decoration-none">
                                    Xem các món trái cây &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-white">
                        <div class="season-img-wrap">
                            <img src="https://images.unsplash.com/photo-1541658016709-82535e94bc69?q=80&w=800&auto=format&fit=crop"
                                 alt="Trà sữa Oolong nướng" />
                        </div>
                        <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Mùa Thu</span>
                                <h5 class="fw-bold mb-2">Trà Sữa Oolong Nướng</h5>
                                <p class="text-muted small mb-3">
                                    Lá trà được sao sấy than củi tạo hương thơm mộc nhẹ, quyện cùng sữa béo ngậy.
                                </p>
                            </div>
                            <div class="pt-2 border-top">
                                <a href="@Url.Action("Products", "Customer", new { categoryId = 1 })" class="text-primary fw-semibold small text-decoration-none">
                                    Xem các món trà sữa &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-lift overflow-hidden bg-white">
                        <div class="season-img-wrap">
                            <img src="https://images.unsplash.com/photo-1536256263959-770b48d82b0a?q=80&w=800&auto=format&fit=crop"
                                 alt="Matcha Macchiato" />
                        </div>
                        <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Mùa Lễ Hội</span>
                                <h5 class="fw-bold mb-2">Matcha Uji & Macchiato</h5>
                                <p class="text-muted small mb-3">
                                    Vị thanh của Matcha nguyên chất hòa quyện lớp kem bọt sữa béo mịn ấm lòng.
                                </p>
                            </div>
                            <div class="pt-2 border-top">
                                <a href="@Url.Action("Products", "Customer", new { categoryId = 5 })" class="text-primary fw-semibold small text-decoration-none">
                                    Xem các món Matcha &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. 3 MẸO BẢO QUẢN -->
    <section class="py-5 bg-white border-top border-light-subtle">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="text-muted fw-bold text-uppercase small">Mẹo nhỏ</span>
                <h2 class="fw-bold text-dark text-uppercase mt-1">Cách Thưởng Thức Trà Ngon</h2>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-4 rounded-4 bg-light text-center h-100 hover-lift">
                        <div class="tip-number mb-2">01</div>
                        <h6 class="fw-bold mb-2">Uống trong 2 giờ đầu</h6>
                        <p class="text-muted small mb-0">Thời điểm trân châu dẻo thơm nhất và trà chưa bị đá làm loãng vị.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 rounded-4 bg-light text-center h-100 hover-lift">
                        <div class="tip-number mb-2">02</div>
                        <h6 class="fw-bold mb-2">Bảo quản ngăn mát 4°C - 8°C</h6>
                        <p class="text-muted small mb-0">Nếu để tủ lạnh, nên tách riêng trân châu để tránh bị sượng cứng.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 rounded-4 bg-light text-center h-100 hover-lift">
                        <div class="tip-number mb-2">03</div>
                        <h6 class="fw-bold mb-2">Lắc đều trước khi cắm ống hút</h6>
                        <p class="text-muted small mb-0">Giúp các tầng hương sữa và trà hòa quyện đều trong từng ngụm uống.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
