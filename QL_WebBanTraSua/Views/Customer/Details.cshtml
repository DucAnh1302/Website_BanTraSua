@model QL_WebBanTraSua.Models.product

@{
    ViewBag.Title = Model.name;
    Layout = "~/Views/Shared/LayoutKhachHang.cshtml";

    var variants = ViewBag.Variants as List<QL_WebBanTraSua.Models.product_variants>;
    var toppings = ViewBag.Toppings as List<QL_WebBanTraSua.Models.topping>;
    var related = ViewBag.RelatedProducts as List<QL_WebBanTraSua.Models.product>;

    var defaultVariant = variants != null && variants.Any() ? variants.First() : null;
    decimal defaultPrice = defaultVariant != null ? defaultVariant.price : 0;
    string catName = Model.category != null ? Model.category.name : "Thực Đơn";
}

@helper GetProductImage(string image, string categoryName)
{
    if (!string.IsNullOrEmpty(image))
    {
        if (image.StartsWith("http://") || image.StartsWith("https://"))
        {
            <text>@image</text>
        }
        else
        {
            <text>@Url.Content("~/assets/img/" + image.TrimStart('/'))</text>
        }
    }
    else
    {
        if (categoryName != null && categoryName.Contains("Cà Phê"))
        {
            <text>https://images.unsplash.com/photo-1517701604599-bb29b565090c?q=80&w=800&auto=format&fit=crop</text>
        }
        else if (categoryName != null && categoryName.Contains("Matcha"))
        {
            <text>https://images.unsplash.com/photo-1515823662972-da6a2e4d3002?q=80&w=800&auto=format&fit=crop</text>
        }
        else if (categoryName != null && categoryName.Contains("Trái Cây"))
        {
            <text>https://images.unsplash.com/photo-1556679343-c7306c1976bc?q=80&w=800&auto=format&fit=crop</text>
        }
        else if (categoryName != null && categoryName.Contains("Đá Xay"))
        {
            <text>https://images.unsplash.com/photo-1572490122747-3968b75cc699?q=80&w=800&auto=format&fit=crop</text>
        }
        else
        {
            <text>https://images.unsplash.com/photo-1541658016709-82535e94bc69?q=80&w=800&auto=format&fit=crop</text>
        }
    }
}

<main class="container py-5 mt-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Customer")" class="text-decoration-none text-muted">Trang chủ</a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Products", "Customer", new { categoryId = Model.category_id })" class="text-decoration-none text-muted">@catName</a>
            </li>
            <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">
                @Model.name
            </li>
        </ol>
    </nav>

    <!-- Chi tiết sản phẩm -->
    <div class="row g-5 align-items-start">
        <!-- Hình ảnh món -->
        <div class="col-lg-5">
            <div class="position-relative shadow-sm rounded-4 overflow-hidden border bg-white">
                <img src="@GetProductImage(Model.image, catName)"
                     onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1541658016709-82535e94bc69?q=80&w=800&auto=format&fit=crop';"
                     class="img-fluid w-100"
                     alt="@Model.name"
                     style="object-fit: cover; aspect-ratio: 4/5; min-height: 420px;" />
                <span class="position-absolute top-0 start-0 m-3 badge bg-primary px-3 py-2 rounded-pill text-uppercase fw-bold">
                    @catName
                </span>
            </div>
        </div>

        <!-- Thông tin & Tùy chỉnh lựa chọn -->
        <div class="col-lg-7">
            <h2 class="fw-bolder mb-2 text-dark">@Model.name</h2>
            <p class="text-muted mb-3 fs-6">
                @(string.IsNullOrEmpty(Model.description) ? "Thức uống tươi ngon được pha chế với nguyên liệu hảo hạng tại Tiệm Trà Sữa." : Model.description)
            </p>

            <div class="d-flex align-items-baseline gap-2 mb-4">
                <span class="text-muted small">Giá món:</span>
                <h3 class="text-primary fw-bolder display-6 mb-0" id="display-price">
                    @string.Format("{0:N0}₫", defaultPrice)
                </h3>
            </div>

            <!-- Form tùy chỉnh & Thêm giỏ hàng -->
            <form action="@Url.Action("ThemGioHang", "Customer")" method="POST" id="product-form"
                  class="bg-white p-4 rounded-4 shadow-sm border">
                
                <input type="hidden" name="productId" value="@Model.id" />

                <!-- 1. Chọn Size -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-3 text-dark">
                        1. Chọn Size Kích Thước <span class="text-danger">*</span>
                    </h6>
                    <div class="d-flex flex-wrap gap-3">
                        @if (variants != null && variants.Any())
                        {
                            int vIdx = 0;
                            foreach (var v in variants)
                            {
                                bool isFirst = vIdx == 0;
                                string radioId = "size_" + v.id;
                                <input type="radio"
                                       class="btn-check size-radio"
                                       name="variantId"
                                       id="@radioId"
                                       value="@v.id"
                                       data-price="@v.price"
                                       @(isFirst ? "checked" : "") />
                                <label class="btn btn-outline-secondary option-pill" for="@radioId">
                                    Size @v.size (@string.Format("{0:N0}₫", v.price))
                                </label>
                                vIdx++;
                            }
                        }
                    </div>
                </div>

                <div class="row">
                    <!-- 2. Chọn Đường -->
                    <div class="col-md-6 mb-4">
                        <h6 class="fw-bold mb-3 text-dark">
                            2. Lượng Đường <span class="text-danger">*</span>
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            <input type="radio" class="btn-check" name="sugar" id="sugar100" value="100" checked />
                            <label class="btn btn-outline-secondary option-pill" for="sugar100">100%</label>

                            <input type="radio" class="btn-check" name="sugar" id="sugar70" value="70" />
                            <label class="btn btn-outline-secondary option-pill" for="sugar70">70%</label>

                            <input type="radio" class="btn-check" name="sugar" id="sugar50" value="50" />
                            <label class="btn btn-outline-secondary option-pill" for="sugar50">50%</label>

                            <input type="radio" class="btn-check" name="sugar" id="sugar30" value="30" />
                            <label class="btn btn-outline-secondary option-pill" for="sugar30">30%</label>

                            <input type="radio" class="btn-check" name="sugar" id="sugar0" value="0" />
                            <label class="btn btn-outline-secondary option-pill" for="sugar0">0% (Không đường)</label>
                        </div>
                    </div>

                    <!-- 3. Chọn Đá -->
                    <div class="col-md-6 mb-4">
                        <h6 class="fw-bold mb-3 text-dark">
                            3. Lượng Đá <span class="text-danger">*</span>
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            <input type="radio" class="btn-check" name="ice" id="iceNormal" value="normal" checked />
                            <label class="btn btn-outline-secondary option-pill" for="iceNormal">100% Đá</label>

                            <input type="radio" class="btn-check" name="ice" id="iceLess" value="less" />
                            <label class="btn btn-outline-secondary option-pill" for="iceLess">50% Đá</label>

                            <input type="radio" class="btn-check" name="ice" id="iceNone" value="none" />
                            <label class="btn btn-outline-secondary option-pill" for="iceNone">Không Đá</label>
                        </div>
                    </div>
                </div>

                <!-- 4. Chọn Topping (Tùy chọn) -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-3 text-dark">
                        4. Thêm Topping Yêu Thích (Tùy chọn)
                    </h6>
                    <div class="row row-cols-1 row-cols-sm-2 g-2">
                        @if (toppings != null && toppings.Any())
                        {
                            foreach (var top in toppings)
                            {
                                string topCheckId = "top_" + top.id;
                                <div class="col">
                                    <div class="topping-card d-flex justify-content-between align-items-center">
                                        <div class="form-check m-0">
                                            <input class="form-check-input topping-checkbox"
                                                   type="checkbox"
                                                   name="toppingIds"
                                                   value="@top.id"
                                                   data-price="@top.price"
                                                   id="@topCheckId" />
                                            <label class="form-check-label fw-medium ms-1" for="@topCheckId" style="cursor: pointer;">
                                                @top.name
                                            </label>
                                        </div>
                                        <span class="text-primary fw-bold small">+@string.Format("{0:N0}₫", top.price)</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- 5. Ghi chú đặc biệt -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-2 text-dark">5. Ghi chú thêm (Tùy chọn)</h6>
                    <input type="text"
                           name="note"
                           class="form-control rounded-3"
                           placeholder="Ví dụ: Giao ít đá, uống ngay..." />
                </div>

                <!-- Nút Số Lượng & Nút Thêm vào giỏ -->
                <div class="d-flex flex-column flex-sm-row gap-3 align-items-center pt-3 border-top">
                    <!-- Bộ đếm số lượng -->
                    <div class="input-group" style="width: 140px;">
                        <button class="btn btn-outline-secondary px-3 fw-bold"
                                type="button"
                                onclick="updateQuantity(-1)">
                            -
                        </button>
                        <input type="number"
                               name="quantity"
                               id="item-quantity"
                               class="form-control text-center fw-bold bg-white"
                               value="1"
                               min="1"
                               max="99"
                               readonly />
                        <button class="btn btn-outline-secondary px-3 fw-bold"
                                type="button"
                                onclick="updateQuantity(1)">
                            +
                        </button>
                    </div>

                    <!-- Nút Thêm vào giỏ hàng -->
                    <button type="submit"
                            class="btn btn-primary btn-lg rounded-pill flex-grow-1 fw-bold text-uppercase w-100 shadow">
                        <i class="bi bi-bag-plus-fill me-2"></i>Thêm vào giỏ - <span id="btn-total-price">@string.Format("{0:N0}₫", defaultPrice)</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Món cùng danh mục -->
    @if (related != null && related.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <h4 class="fw-bold text-uppercase mb-4">
                <i class="bi bi-stars me-2 text-primary"></i>Gợi Ý Cùng Danh Mục
            </h4>
            <div class="row row-cols-1 row-cols-md-4 g-4">
                @foreach (var r in related)
                {
                    var rVariants = r.product_variants.ToList();
                    decimal rPrice = rVariants.Any() ? rVariants.Min(v => v.price) : 0;
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white product-card">
                            <a href="@Url.Action("Details", "Customer", new { id = r.id })">
                                <img src="@GetProductImage(r.image, catName)"
                                     class="card-img-top"
                                     alt="@r.name"
                                     style="height: 180px; object-fit: cover;" />
                            </a>
                            <div class="card-body p-3 d-flex flex-column">
                                <h6 class="fw-bold mb-1">
                                    <a href="@Url.Action("Details", "Customer", new { id = r.id })" class="text-dark text-decoration-none">
                                        @r.name
                                    </a>
                                </h6>
                                <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                    <span class="text-primary fw-bold">@string.Format("{0:N0}₫", rPrice)</span>
                                    <a href="@Url.Action("Details", "Customer", new { id = r.id })" class="btn btn-sm btn-outline-primary rounded-pill fw-bold">
                                        Xem
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</main>

<script>
    function calculateTotal() {
        var basePrice = 0;
        var selectedSize = document.querySelector('input[name="variantId"]:checked');
        if (selectedSize) {
            basePrice = parseFloat(selectedSize.getAttribute('data-price')) || 0;
        }

        var toppingsPrice = 0;
        var checkedToppings = document.querySelectorAll('.topping-checkbox:checked');
        checkedToppings.forEach(function (top) {
            toppingsPrice += parseFloat(top.getAttribute('data-price')) || 0;
        });

        var qtyInput = document.getElementById('item-quantity');
        var qty = parseInt(qtyInput.value) || 1;

        var unitPrice = basePrice + toppingsPrice;
        var totalPrice = unitPrice * qty;

        var formattedUnit = unitPrice.toLocaleString('vi-VN') + '₫';
        var formattedTotal = totalPrice.toLocaleString('vi-VN') + '₫';

        document.getElementById('display-price').textContent = formattedUnit;
        document.getElementById('btn-total-price').textContent = formattedTotal;
    }

    function updateQuantity(delta) {
        var qtyInput = document.getElementById('item-quantity');
        var current = parseInt(qtyInput.value) || 1;
        var next = current + delta;
        if (next < 1) next = 1;
        if (next > 99) next = 99;
        qtyInput.value = next;
        calculateTotal();
    }

    document.addEventListener('DOMContentLoaded', function () {
        var sizeRadios = document.querySelectorAll('.size-radio');
        sizeRadios.forEach(function (radio) {
            radio.addEventListener('change', calculateTotal);
        });

        var toppingCheckboxes = document.querySelectorAll('.topping-checkbox');
        toppingCheckboxes.forEach(function (box) {
            box.addEventListener('change', calculateTotal);
        });

        calculateTotal();
    });
</script>
