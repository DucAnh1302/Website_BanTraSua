@model QL_WebBanTraSua.Models.product
@{
    ViewBag.Title = "Chỉnh Sửa Món Nước - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">✏️ Chỉnh Sửa Món Nước</h3>
        <p class="text-muted small mb-0">Cập nhật thông tin, danh mục, hình ảnh và bảng giá món: <strong>@Model.name</strong></p>
    </div>
    <div>
        <a href="/Admin/QuanLySanPham" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Món Nước #@Model.id</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/SuaSanPham" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên món nước <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required value="@Model.name" />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                        @Html.DropDownList("category_id", (SelectList)ViewBag.Categories, new { @class = "form-select", @required = "required" })
                        @Html.ValidationMessage("category_id", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình ảnh món nước</label>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            @{
                                string imgPath = "";
                                if (!string.IsNullOrEmpty(Model.image))
                                {
                                    imgPath = Model.image.StartsWith("products/")
                                        ? Url.Content("~/Content/images/" + Model.image)
                                        : Url.Content("~/Content/images/products/" + Model.image);
                                }
                                else
                                {
                                    imgPath = Url.Content("~/Content/images/products/bac_xiu.jpg");
                                }
                            }
                            <img id="imgPreview" src="@imgPath" alt="@Model.name" style="width: 90px; height: 90px; object-fit: cover;" class="rounded border shadow-sm" onerror="this.onerror=null; this.src='@Url.Content("~/Content/images/products/bac_xiu.jpg")';" />
                            <div>
                                <label class="form-label small fw-bold">Chọn ảnh mới để thay thế:</label>
                                <input type="file" name="imageFile" id="imageFileInput" class="form-control form-control-sm" accept="image/*" onchange="if(this.files && this.files[0]){ document.getElementById('imgPreview').src = window.URL.createObjectURL(this.files[0]); }" />
                                <div class="form-text small text-muted">Chọn tệp ảnh từ máy tính để xem trước ngay lập tức.</div>
                            </div>
                        </div>
                        <input type="text" name="image" id="imageUrlInput" class="form-control form-control-sm" value="@Model.image" placeholder="Hoặc nhập đường dẫn ảnh..." oninput="if(this.value){ document.getElementById('imgPreview').src = this.value; }" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Mô tả hương vị & đặc điểm</label>
                        <textarea name="description" rows="3" class="form-control">@Model.description</textarea>
                    </div>

                    <!-- Bảng giá các size S, M, L -->
                    <div class="card bg-light border p-3 mb-4 rounded-3">
                        <h6 class="fw-bold mb-3 text-primary">💰 Cập Nhật Bảng Giá Các Size (VNĐ)</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Giá Size S</label>
                                <div class="input-group">
                                    <input type="number" name="priceS" class="form-control" value="@ViewBag.PriceS" min="0" step="1000" />
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Giá Size M</label>
                                <div class="input-group">
                                    <input type="number" name="priceM" class="form-control" value="@ViewBag.PriceM" min="0" step="1000" />
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Giá Size L</label>
                                <div class="input-group">
                                    <input type="number" name="priceL" class="form-control" value="@ViewBag.PriceL" min="0" step="1000" />
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_active" value="true" @(Model.is_active ? "checked" : "") id="isActiveEditSwitch">
                            <input type="hidden" name="is_active" value="false" />
                            <label class="form-check-label fw-bold" for="isActiveEditSwitch">Đang mở bán trên menu</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLySanPham" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Cập Nhật Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
