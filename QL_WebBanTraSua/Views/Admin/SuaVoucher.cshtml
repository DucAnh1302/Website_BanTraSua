@model QL_WebBanTraSua.Models.voucher
@{
    ViewBag.Title = "Chỉnh Sửa Mã Khuyến Mãi - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">✏️ Chỉnh Sửa Mã Voucher #@Model.code</h3>
        <p class="text-muted small mb-0">Cập nhật hạn mức chiết khấu, điều kiện áp dụng và thời gian có hiệu lực</p>
    </div>
    <div>
        <a href="/Admin/QuanLyVoucher" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Cập Nhật Mã @Model.code</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/SuaVoucher">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mã Voucher (Code)</label>
                            <input type="text" class="form-control text-uppercase fw-bold bg-light" disabled value="@Model.code" />
                            <small class="text-muted">Mã code không thể thay đổi sau khi tạo.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tên chương trình ưu đãi <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" required value="@Model.name" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Loại hình giảm giá</label>
                            <select name="discount_type" class="form-select">
                                <option value="percent" @(Model.discount_type == "percent" ? "selected" : "")>Phần trăm (%)</option>
                                <option value="fixed" @(Model.discount_type == "fixed" ? "selected" : "")>Số tiền cố định (VNĐ)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá trị giảm <span class="text-danger">*</span></label>
                            <input type="number" name="discount_value" class="form-control" required value="@Model.discount_value" min="1" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mức giảm tối đa (VNĐ)</label>
                            <input type="number" name="max_discount" class="form-control" value="@Model.max_discount" min="0" step="1000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá trị đơn hàng tối thiểu (VNĐ)</label>
                            <input type="number" name="min_order_value" class="form-control" value="@Model.min_order_value" min="0" step="1000" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hạng hội viên áp dụng</label>
                            <select name="required_tier" class="form-select">
                                <option value="" @(string.IsNullOrEmpty(Model.required_tier) ? "selected" : "")>Tất cả khách hàng (Không yêu cầu)</option>
                                <option value="Đồng" @(Model.required_tier == "Đồng" ? "selected" : "")>Chỉ từ hạng Đồng</option>
                                <option value="Bạc" @(Model.required_tier == "Bạc" ? "selected" : "")>Chỉ từ hạng Bạc</option>
                                <option value="Vàng" @(Model.required_tier == "Vàng" ? "selected" : "")>Chỉ từ hạng Vàng</option>
                                <option value="Kim Cương" @(Model.required_tier == "Kim Cương" ? "selected" : "")>Chỉ dành riêng Kim Cương</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tổng lượt sử dụng tối đa</label>
                            <input type="number" name="usage_limit" class="form-control" value="@Model.usage_limit" min="1" />
                            <div class="form-text small">Đã dùng: <strong>@Model.used_count lượt</strong></div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày hết hạn</label>
                            <input type="datetime-local" name="expires_at" class="form-control" value="@(Model.expires_at.HasValue ? Model.expires_at.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" name="is_active" value="true" @(Model.is_active ? "checked" : "") id="vcEditActiveSwitch">
                                <input type="hidden" name="is_active" value="false" />
                                <label class="form-check-label fw-bold" for="vcEditActiveSwitch">Đang kích hoạt mã</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyVoucher" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Cập Nhật Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
