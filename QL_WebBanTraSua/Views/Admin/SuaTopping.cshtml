@model QL_WebBanTraSua.Models.topping
@{
    ViewBag.Title = "Chỉnh Sửa Topping - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">✏️ Chỉnh Sửa Topping #@Model.id</h3>
        <p class="text-muted small mb-0">Cập nhật giá bán, định lượng và trạng thái của topping <strong>@Model.name</strong></p>
    </div>
    <div>
        <a href="/Admin/QuanLyTopping" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Topping</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/SuaTopping">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Topping <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required value="@Model.name" />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Giá bán thêm (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" name="price" class="form-control" required min="0" step="1000" value="@Convert.ToInt64(Model.price)" />
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nguyên liệu kho tương ứng (BOM)</label>
                        @Html.DropDownList("ingredient_id", (SelectList)ViewBag.Ingredients, "-- Không liên kết --", new { @class = "form-select" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Định lượng tiêu thụ mỗi phần</label>
                        <input type="number" name="amount_per_serving" class="form-control" value="@Model.amount_per_serving" step="0.1" min="0" />
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_active" value="true" @(Model.is_active ? "checked" : "") id="tpEditActiveSwitch">
                            <input type="hidden" name="is_active" value="false" />
                            <label class="form-check-label fw-bold" for="tpEditActiveSwitch">Đang kích hoạt phục vụ</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyTopping" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Cập Nhật Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
