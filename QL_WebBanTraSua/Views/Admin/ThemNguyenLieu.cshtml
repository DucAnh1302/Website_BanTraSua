@model QL_WebBanTraSua.Models.ingredient
@{
    ViewBag.Title = "Thêm Nguyên Liệu Mới - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">➕ Thêm Nguyên Liệu Kho Mới</h3>
        <p class="text-muted small mb-0">Khai báo danh mục nguyên liệu thô phục vụ công thức pha chế (BOM) và trừ kho</p>
    </div>
    <div>
        <a href="/Admin/QuanLyKho" class="btn btn-outline-secondary">
            &larr; Quay lại kho
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Nguyên Liệu</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/ThemNguyenLieu">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên nguyên liệu <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Cốt Trà Đen, Bột Sữa Béo, Siro Vải..." />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                            <input type="text" name="unit" class="form-control" required placeholder="g, ml, hộp, kg..." />
                            @Html.ValidationMessage("unit", "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Vai trò tiêu thụ</label>
                            <select name="consumption_role" class="form-select">
                                <option value="normal">Thông thường (Món nước)</option>
                                <option value="topping">Dùng cho Topping</option>
                                <option value="packaging">Bao bì / Ly / Ống hút</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số lượng tồn ban đầu</label>
                            <input type="number" name="stock_quantity" class="form-control" value="0" step="any" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngưỡng an toàn tối thiểu (min_stock)</label>
                            <input type="number" name="min_stock" class="form-control" value="100" step="any" min="0" />
                            <div class="form-text small">Khi tồn kho dưới mức này, hệ thống sẽ phát cảnh báo cạn kho.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyKho" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Tạo Nguyên Liệu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
