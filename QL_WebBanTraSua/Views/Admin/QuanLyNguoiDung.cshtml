@using QL_WebBanTraSua.Models
@model List<user>
@{
    ViewBag.Title = "Quản Lý Người Dùng & Nhân Sự - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    string currentRole = ViewBag.CurrentRole as string ?? "";
    string currentSearch = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">👥 Quản Lý Người Dùng & Nhân Sự</h3>
        <p class="text-muted small mb-0">Quản lý hồ sơ khách hàng, điểm tích lũy thành viên và phân quyền nhân viên nội bộ</p>
    </div>
    <div>
        <a href="/Admin/ThemNhanVien" class="btn btn-primary">
            ➕ Tạo Tài Khoản Nhân Sự Mới
        </a>
    </div>
</div>

<!-- Bộ lọc vai trò (Pure HTML Links - Zero JS) -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="/Admin/QuanLyNguoiDung" class="btn btn-sm @(string.IsNullOrEmpty(currentRole) ? "btn-dark fw-bold" : "btn-outline-secondary")">
        Tất cả người dùng
    </a>
    <a href="/Admin/QuanLyNguoiDung?role=customer" class="btn btn-sm @(currentRole == "customer" ? "btn-primary fw-bold" : "btn-outline-primary")">
        🛍️ Khách hàng (@Model.Count(u => u.role == "customer"))
    </a>
    <a href="/Admin/QuanLyNguoiDung?role=admin" class="btn btn-sm @(currentRole == "admin" ? "btn-danger fw-bold" : "btn-outline-danger")">
        👑 Quản trị viên (Admin)
    </a>
    <a href="/Admin/QuanLyNguoiDung?role=pos" class="btn btn-sm @(currentRole == "pos" ? "btn-success fw-bold" : "btn-outline-success")">
        💼 Thu ngân (POS)
    </a>
    <a href="/Admin/QuanLyNguoiDung?role=kho" class="btn btn-sm @(currentRole == "kho" ? "btn-warning fw-bold text-dark" : "btn-outline-warning text-dark")">
        📦 Thủ kho
    </a>
    <a href="/Admin/QuanLyNguoiDung?role=staff" class="btn btn-sm @(currentRole == "staff" ? "btn-info fw-bold text-dark" : "btn-outline-info text-dark")">
        ☕ Nhân viên pha chế
    </a>
</div>

<!-- Form tìm kiếm người dùng -->
<div class="card-custom mb-4">
    <div class="card-body">
        <form method="get" action="/Admin/QuanLyNguoiDung" class="row g-2 align-items-center">
            @if (!string.IsNullOrEmpty(currentRole))
            {
                <input type="hidden" name="role" value="@currentRole" />
            }
            <div class="col-md-9">
                <input type="text" name="search" class="form-control" placeholder="Tìm kiếm theo họ tên, địa chỉ email hoặc số điện thoại..." value="@currentSearch" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    🔍 Tra Cứu
                </button>
                <a href="/Admin/QuanLyNguoiDung" class="btn btn-outline-secondary" title="Đặt lại">
                    ↺
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách người dùng -->
<div class="card-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Danh Sách Tài Khoản (@Model.Count)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Họ tên</th>
                        <th>Email liên hệ</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò phân quyền</th>
                        <th>Hạng & Điểm tích lũy</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var u in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#@u.id</td>
                                <td>
                                    <div class="fw-bold text-dark">@u.name</div>
                                    <small class="text-muted">Tham gia: @(u.created_at.HasValue ? u.created_at.Value.ToString("dd/MM/yyyy") : "")</small>
                                </td>
                                <td>
                                    <span class="text-primary font-monospace small">@u.email</span>
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(u.phone) ? "-" : u.phone)
                                </td>
                                <td>
                                    @if (u.role == "admin")
                                    {
                                        <span class="badge bg-danger">👑 Administrator</span>
                                    }
                                    else if (u.role == "pos")
                                    {
                                        <span class="badge bg-success">💼 Thu ngân POS</span>
                                    }
                                    else if (u.role == "kho")
                                    {
                                        <span class="badge bg-warning text-dark">📦 Thủ kho</span>
                                    }
                                    else if (u.role == "staff")
                                    {
                                        <span class="badge bg-info text-dark">☕ Pha chế / Phục vụ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">🛍️ Khách hàng</span>
                                    }
                                </td>
                                <td>
                                    @if (u.role == "customer")
                                    {
                                        <div>
                                            <span class="badge bg-secondary">Hạng @u.tier</span>
                                            <span class="fw-bold text-primary small ms-1">@u.points pts</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tài khoản nội bộ</span>
                                    }
                                </td>
                                <td>
                                    @if (u.status)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Đang khóa</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a href="/Admin/SuaNguoiDung/@u.id" class="btn btn-sm btn-outline-primary" title="Sửa thông tin">
                                            ✏️ Sửa
                                        </a>

                                        <form method="post" action="/Admin/ToggleTrangThaiNguoiDung" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.id" />
                                            <button type="submit" class="btn btn-sm @(u.status ? "btn-outline-danger" : "btn-outline-success")" title="@(u.status ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                @(u.status ? "Khóa" : "Mở")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                Không tìm thấy người dùng nào!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
