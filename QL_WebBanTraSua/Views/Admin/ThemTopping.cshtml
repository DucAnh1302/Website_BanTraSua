@model QL_WebBanTraSua.Models.topping
@{
    ViewBag.Title = "Thêm Topping Mới - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">➕ Thêm Topping Mới</h3>
        <p class="text-muted small mb-0">Tạo loại topping mới và cấu hình định lượng trừ kho tự động</p>
    </div>
    <div>
        <a href="/Admin/QuanLyTopping" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Topping</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/ThemTopping">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Topping <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Trân Châu Đen Hoàng Kim..." />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Giá bán thêm (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" name="price" class="form-control" required placeholder="10000" min="0" step="1000" value="10000" />
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nguyên liệu kho tương ứng (BOM)</label>
                        @Html.DropDownList("ingredient_id", (SelectList)ViewBag.Ingredients, "-- Chọn nguyên liệu trong kho --", new { @class = "form-select" })
                        <div class="form-text">Khi khách đặt topping này, kho sẽ tự động trừ lượng nguyên liệu tương ứng.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Định lượng tiêu thụ mỗi phần</label>
                        <input type="number" name="amount_per_serving" class="form-control" placeholder="Ví dụ: 30 (gram)" step="0.1" min="0" />
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_active" value="true" checked id="tpActiveSwitch">
                            <input type="hidden" name="is_active" value="false" />
                            <label class="form-check-label fw-bold" for="tpActiveSwitch">Kích hoạt sẵn sàng phục vụ</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyTopping" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Lưu Topping
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
