@using QL_WebBanTraSua.Models
@model List<category>
@{
    ViewBag.Title = "Quản Lý Danh Mục - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string currentSearch = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">📁 Quản Lý Danh Mục Trà Sữa</h3>
        <p class="text-muted small mb-0">Phân nhóm các món nước như Trà Sữa, Trà Trái Cây, Cà Phê, Đá Xay,...</p>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thêm danh mục mới -->
    <div class="col-lg-4">
        <div class="card-custom">
            <div class="card-header fw-bold">➕ Thêm Danh Mục Mới</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/ThemDanhMuc">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Trà Sữa Nguyên Bản, Macchiato..." />
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_active" value="true" checked id="dmActiveSwitch">
                            <input type="hidden" name="is_active" value="false" />
                            <label class="form-check-label fw-bold" for="dmActiveSwitch">Kích hoạt hiển thị</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        Tạo Danh Mục
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Cột phải: Danh sách danh mục -->
    <div class="col-lg-8">
        <div class="card-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Danh Sách Danh Mục (@Model.Count)</span>
                <!-- Form tìm kiếm nhanh -->
                <form method="get" action="/Admin/QuanLyDanhMuc" class="d-inline-flex gap-2">
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm danh mục..." value="@currentSearch" />
                    <button type="submit" class="btn btn-sm btn-secondary">Tìm</button>
                </form>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th>Tên danh mục</th>
                                <th>Số món nước</th>
                                <th>Trạng thái</th>
                                <th class="text-end" style="width: 200px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-muted fw-bold">#@item.id</td>
                                        <td>
                                            <a href="/Admin/QuanLySanPham?category_id=@item.id" class="fw-bold text-dark text-decoration-none" title="Xem các món trong danh mục">
                                                @item.name &rarr;
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @(item.products != null ? item.products.Count : 0) món
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.is_active)
                                            {
                                                <span class="badge bg-success">Đang hiện</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Tạm ẩn</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1 align-items-center">
                                                <a href="/Admin/SuaDanhMuc/@item.id" class="btn btn-sm btn-outline-primary" title="Sửa danh mục">
                                                    ✏️ Sửa
                                                </a>

                                                <form method="post" action="/Admin/ToggleTrangThaiDanhMuc" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.id" />
                                                    <button type="submit" class="btn btn-sm @(item.is_active ? "btn-outline-warning" : "btn-outline-success")">
                                                        @(item.is_active ? "Ẩn" : "Bật")
                                                    </button>
                                                </form>

                                                <form method="post" action="/Admin/XoaDanhMuc" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa danh mục">
                                                        🗑️
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">Chưa có danh mục nào phù hợp!</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
