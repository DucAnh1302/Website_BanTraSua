@using QL_WebBanTraSua.Models
@model List<product>
@{
    ViewBag.Title = "Quản Lý Sản Phẩm - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var categories = ViewBag.Categories as List<category> ?? new List<category>();
    long currentCatId = ViewBag.CategoryId != null ? (long)ViewBag.CategoryId : 0;
    string currentStatus = ViewBag.Status as string ?? "";
    string currentSearch = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">🧋 Quản Lý Thực Đơn Trà Sữa</h3>
        <p class="text-muted small mb-0">Quản lý danh sách món nước, điều chỉnh giá theo từng size và trạng thái mở bán</p>
    </div>
    <div>
        <a href="/Admin/ThemSanPham" class="btn btn-primary">
            <span>➕</span> Thêm Món Nước Mới
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm (Pure HTML Form GET - Zero JS) -->
<div class="card-custom mb-4">
    <div class="card-body">
        <form method="get" action="/Admin/QuanLySanPham" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Tìm kiếm tên món nước</label>
                <input type="text" name="search" class="form-control" placeholder="Nhập tên món trà sữa..." value="@currentSearch" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Danh mục</label>
                <select name="category_id" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.id" @(currentCatId == c.id ? "selected" : "")>@c.name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Trạng thái mở bán</label>
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active" @(currentStatus == "active" ? "selected" : "")>Đang mở bán</option>
                    <option value="inactive" @(currentStatus == "inactive" ? "selected" : "")>Tạm ngưng bán</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">
                    Lọc dữ liệu
                </button>
                <a href="/Admin/QuanLySanPham" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                    ↺
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách sản phẩm -->
<div class="card-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Danh Sách Món Nước (@Model.Count món)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Biến thể Size & Giá</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 220px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.image))
                                    {
                                        string imgPath = item.image.StartsWith("products/")
                                            ? Url.Content("~/Content/images/" + item.image)
                                            : Url.Content("~/Content/images/products/" + item.image);

                                        <img src="@imgPath" alt="@item.name" style="width: 54px; height: 54px; object-fit: cover;" class="rounded border shadow-sm" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded border text-muted d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; font-size: 1.5rem;">
                                            🧋
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.name</div>
                                    <small class="text-muted d-inline-block text-truncate" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(item.description) ? "Chưa có mô tả" : item.description)
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.category != null ? item.category.name : "N/A")
                                    </span>
                                </td>
                                <td>
                                    @if (item.product_variants != null && item.product_variants.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var v in item.product_variants.OrderBy(x => x.size))
                                            {
                                                <span class="badge bg-light text-secondary border">
                                                    <strong>Size @v.size:</strong> @string.Format("{0:N0}đ", v.price)
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa thiết lập giá</span>
                                    }
                                </td>
                                <td>
                                    @if (item.is_active)
                                    {
                                        <span class="badge bg-success">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ẩn</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a href="/Admin/SuaSanPham/@item.id" class="btn btn-sm btn-outline-primary" title="Sửa thông tin">
                                            ✏️ Sửa
                                        </a>

                                        <!-- Nút đổi trạng thái qua Form POST thuần -->
                                        <form method="post" action="/Admin/ToggleTrangThaiSanPham" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.id" />
                                            <button type="submit" class="btn btn-sm @(item.is_active ? "btn-outline-warning" : "btn-outline-success")" title="@(item.is_active ? "Tạm ngưng mở bán" : "Kích hoạt bán lại")">
                                                @(item.is_active ? "Ẩn" : "Bật")
                                            </button>
                                        </form>

                                        <!-- Nút xóa sản phẩm qua Form POST thuần -->
                                        <form method="post" action="/Admin/XoaSanPham" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa món này">
                                                🗑️
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                Không tìm thấy món nước nào phù hợp với điều kiện tìm kiếm!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
