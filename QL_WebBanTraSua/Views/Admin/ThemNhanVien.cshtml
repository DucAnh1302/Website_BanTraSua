@model QL_WebBanTraSua.Models.user
@{
    ViewBag.Title = "Thêm Tài Khoản Nhân Sự Mới - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">➕ Phân Quyền & Tạo Nhân Sự Mới</h3>
        <p class="text-muted small mb-0">Cấp tài khoản đăng nhập nội bộ cho Quản trị viên, Thu ngân POS, Thủ kho hoặc Nhân viên pha chế</p>
    </div>
    <div>
        <a href="/Admin/QuanLyNguoiDung" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Nhân Viên Nội Bộ</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/ThemNhanVien">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên nhân viên <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Nguyễn Văn A..." />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email đăng nhập <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" required placeholder="nhanvien@teabloom.vn" />
                        @Html.ValidationMessage("email", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control" required placeholder="Nhập mật khẩu..." />
                        @Html.ValidationMessage("password", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại liên hệ</label>
                        <input type="text" name="phone" class="form-control" placeholder="0988776655" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Vai trò phân quyền nội bộ <span class="text-danger">*</span></label>
                        <select name="role" class="form-select" required>
                            <option value="admin">👑 Quản trị viên (Toàn quyền hệ thống)</option>
                            <option value="pos" selected>💼 Thu ngân POS (Bán hàng & Tiếp nhận đơn)</option>
                            <option value="kho">📦 Thủ kho (Quản lý nguyên liệu & Lô hàng)</option>
                            <option value="staff">☕ Nhân viên pha chế & Phục vụ</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyNguoiDung" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Tạo Tài Khoản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
