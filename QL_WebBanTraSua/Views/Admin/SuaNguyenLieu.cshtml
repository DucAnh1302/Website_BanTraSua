@model QL_WebBanTraSua.Models.ingredient
@{
    ViewBag.Title = "Chỉnh Sửa Nguyên Liệu - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">✏️ Chỉnh Sửa Nguyên Liệu #@Model.id</h3>
        <p class="text-muted small mb-0">Cập nhật tên, đơn vị tính và định mức an toàn của nguyên liệu <strong>@Model.name</strong></p>
    </div>
    <div>
        <a href="/Admin/QuanLyKho" class="btn btn-outline-secondary">
            &larr; Quay lại kho
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Nguyên Liệu</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/SuaNguyenLieu">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên nguyên liệu <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required value="@Model.name" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                            <input type="text" name="unit" class="form-control" required value="@Model.unit" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Vai trò tiêu thụ</label>
                            <select name="consumption_role" class="form-select">
                                <option value="normal" @(Model.consumption_role == "normal" ? "selected" : "")>Thông thường (Món nước)</option>
                                <option value="topping" @(Model.consumption_role == "topping" ? "selected" : "")>Dùng cho Topping</option>
                                <option value="packaging" @(Model.consumption_role == "packaging" ? "selected" : "")>Bao bì / Ly / Ống hút</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Ngưỡng an toàn tối thiểu (min_stock)</label>
                        <input type="number" name="min_stock" class="form-control" value="@Model.min_stock" step="any" min="0" />
                        <div class="form-text small">Tồn kho hiện tại: <strong>@Model.stock_quantity @Model.unit</strong> (Dùng chức năng Nhập kho để tăng số lượng tồn)</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyKho" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Cập Nhật Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
