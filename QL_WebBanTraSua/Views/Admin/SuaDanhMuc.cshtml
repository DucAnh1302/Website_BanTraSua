@model QL_WebBanTraSua.Models.category
@{
    ViewBag.Title = "Chỉnh Sửa Danh Mục - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">✏️ Chỉnh Sửa Danh Mục #@Model.id</h3>
        <p class="text-muted small mb-0">Cập nhật tên danh mục và trạng thái hiển thị trên website</p>
    </div>
    <div>
        <a href="/Admin/QuanLyDanhMuc" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Danh Mục</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/SuaDanhMuc">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required value="@Model.name" />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_active" value="true" @(Model.is_active ? "checked" : "") id="dmEditActiveSwitch">
                            <input type="hidden" name="is_active" value="false" />
                            <label class="form-check-label fw-bold" for="dmEditActiveSwitch">Đang kích hoạt hiển thị</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyDanhMuc" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Cập Nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
