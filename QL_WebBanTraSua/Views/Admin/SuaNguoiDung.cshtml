@model QL_WebBanTraSua.Models.user
@{
    ViewBag.Title = "Chỉnh Sửa Tài Khoản - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">✏️ Chỉnh Sửa Người Dùng #@Model.id</h3>
        <p class="text-muted small mb-0">Cập nhật thông tin liên hệ, phân quyền vai trò và hạng thành viên cho <strong>@Model.name</strong></p>
    </div>
    <div>
        <a href="/Admin/QuanLyNguoiDung" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Tài Khoản</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/SuaNguoiDung">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email đăng nhập</label>
                        <input type="text" class="form-control bg-light" disabled value="@Model.email" />
                        <small class="text-muted">Email định danh duy nhất không được phép thay đổi.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required value="@Model.name" />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input type="text" name="phone" class="form-control" value="@Model.phone" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Đổi mật khẩu mới (Nếu có nhu cầu)</label>
                        <input type="password" name="new_password" class="form-control" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Vai trò trong hệ thống <span class="text-danger">*</span></label>
                        <select name="role" class="form-select">
                            <option value="customer" @(Model.role == "customer" ? "selected" : "")>🛍️ Khách hàng</option>
                            <option value="admin" @(Model.role == "admin" ? "selected" : "")>👑 Quản trị viên (Admin)</option>
                            <option value="pos" @(Model.role == "pos" ? "selected" : "")>💼 Thu ngân (POS)</option>
                            <option value="kho" @(Model.role == "kho" ? "selected" : "")>📦 Thủ kho</option>
                            <option value="staff" @(Model.role == "staff" ? "selected" : "")>☕ Nhân viên pha chế & phục vụ</option>
                        </select>
                    </div>

                    <!-- Khối thông tin tích điểm khách hàng nếu là customer -->
                    <div class="card bg-light border p-3 mb-3 rounded-3">
                        <h6 class="fw-bold mb-2 text-primary">⭐ Thông Tin Thành Viên & Tích Điểm (UC08)</h6>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold">Hạng hội viên</label>
                                <select name="tier" class="form-select form-select-sm">
                                    <option value="Đồng" @(Model.tier == "Đồng" ? "selected" : "")>Hạng Đồng (Bronze)</option>
                                    <option value="Bạc" @(Model.tier == "Bạc" ? "selected" : "")>Hạng Bạc (Silver)</option>
                                    <option value="Vàng" @(Model.tier == "Vàng" ? "selected" : "")>Hạng Vàng (Gold)</option>
                                    <option value="Kim Cương" @(Model.tier == "Kim Cương" ? "selected" : "")>Hạng Kim Cương (Diamond)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Điểm tích lũy (pts)</label>
                                <input type="number" name="points" class="form-control form-control-sm" value="@Model.points" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="status" value="true" @(Model.status ? "checked" : "") id="uStatusSwitch">
                            <input type="hidden" name="status" value="false" />
                            <label class="form-check-label fw-bold" for="uStatusSwitch">Tài khoản đang hoạt động bình thường</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLyNguoiDung" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Cập Nhật Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
