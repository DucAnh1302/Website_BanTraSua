@using QL_WebBanTraSua.Models
@model List<order>
@{
    ViewBag.Title = "Bảng Điều Khiển Tổng Quan (Dashboard)";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var stockAlerts = ViewBag.StockAlerts as List<ingredient> ?? new List<ingredient>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">📊 Bảng Điều Khiển Doanh Thu & Hệ Thống</h3>
        <p class="text-muted small mb-0">Theo dõi thời gian thực doanh thu, tình trạng đơn hàng và cảnh báo kho TeaBloom</p>
    </div>
    <div>
        <a href="/Admin/QuanLyDonHang" class="btn btn-outline-primary btn-sm">
            <span>🧾</span> Quản lý Đơn hàng
        </a>
        <a href="/Admin/QuanLyKho" class="btn btn-outline-danger btn-sm">
            <span>⚠️</span> Kiểm tra Tồn kho
        </a>
    </div>
</div>

<!-- 1. Thống kê Doanh thu & Đơn hàng -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card green">
            <div class="stat-label">💰 Tổng Doanh Thu Hoàn Tất</div>
            <div class="stat-number">@string.Format("{0:N0} đ", ViewBag.TotalRevenue)</div>
            <div class="small mt-2 opacity-75">Hôm nay: @string.Format("{0:N0} đ", ViewBag.TodayRevenue)</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card blue">
            <div class="stat-label">🧾 Tổng Đơn Hàng</div>
            <div class="stat-number">@ViewBag.TotalOrders</div>
            <div class="small mt-2 opacity-75">Đang giao / Pha chế: @(ViewBag.ShippingOrders + ViewBag.PreparingOrders) đơn</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card amber">
            <div class="stat-label">⏳ Đơn Chờ Xác Nhận</div>
            <div class="stat-number">@ViewBag.PendingOrders</div>
            <div class="small mt-2 opacity-75">Cần nhân viên xử lý ngay</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card purple">
            <div class="stat-label">🧋 Thực Đơn & Khách Hàng</div>
            <div class="stat-number">@ViewBag.TotalProducts món</div>
            <div class="small mt-2 opacity-75">@ViewBag.TotalCustomers khách hàng | @ViewBag.TotalStaff nhân sự</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Đơn hàng mới nhất -->
    <div class="col-lg-8">
        <div class="card-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">🧾 Đơn Hàng Gần Đây Cần Xử Lý</span>
                <a href="/Admin/QuanLyDonHang" class="btn btn-sm btn-link text-decoration-none">Xem tất cả &rarr;</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách nhận</th>
                                <th>Tổng tiền</th>
                                <th>Loại đơn</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var o in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-primary">#@o.id</span>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                @(o.created_at.HasValue ? o.created_at.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@(string.IsNullOrEmpty(o.shipping_name) ? (o.user != null ? o.user.name : "Khách tại quầy") : o.shipping_name)</div>
                                            <div class="text-muted small">@o.shipping_phone</div>
                                        </td>
                                        <td class="fw-bold text-danger">
                                            @string.Format("{0:N0} đ", o.final_total)
                                        </td>
                                        <td>
                                            @if (o.order_type == "in_store")
                                            {
                                                <span class="badge bg-secondary">Tại quầy</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">Online</span>
                                            }
                                        </td>
                                        <td>
                                            @if (o.order_status == "pending")
                                            {
                                                <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                            }
                                            else if (o.order_status == "preparing")
                                            {
                                                <span class="badge bg-primary">Đang làm nước</span>
                                            }
                                            else if (o.order_status == "shipping")
                                            {
                                                <span class="badge bg-info text-dark">Đang giao</span>
                                            }
                                            else if (o.order_status == "completed")
                                            {
                                                <span class="badge bg-success">Hoàn thành</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Đã hủy</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="/Admin/ChiTietDonHang/@o.id" class="btn btn-sm btn-outline-primary">
                                                Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Chưa có đơn hàng nào trong hệ thống!</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Cảnh báo cạn kho (UC10) -->
    <div class="col-lg-4">
        <div class="card-custom border-danger">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <span>⚠️ Cảnh Báo Cạn Kho (Stock Alert)</span>
                <span class="badge bg-white text-danger">@stockAlerts.Count loại</span>
            </div>
            <div class="card-body p-0">
                @if (stockAlerts.Count > 0)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var ng in stockAlerts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-bold text-dark">@ng.name</div>
                                    <small class="text-muted">Định mức an toàn: @ng.min_stock @ng.unit</small>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-danger fs-6">@ng.stock_quantity @ng.unit</span>
                                    <div class="mt-1">
                                        <a href="/Admin/QuanLyKho?search=@ng.name" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;">
                                            Nhập kho
                                        </a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-success">
                        <div class="fs-1 mb-2">✅</div>
                        <div class="fw-bold">Kho an toàn!</div>
                        <div class="small text-muted">Toàn bộ nguyên liệu đều đạt trên ngưỡng an toàn.</div>
                    </div>
                }
            </div>
            <div class="card-footer bg-light text-center py-2">
                <a href="/Admin/QuanLyKho" class="btn btn-sm btn-outline-secondary w-100">Vào trung tâm quản lý kho</a>
            </div>
        </div>

        <!-- Phím tắt thao tác nhanh -->
        <div class="card-custom mt-4">
            <div class="card-header fw-bold">⚡ Thao Tác Quản Trị Nhanh</div>
            <div class="card-body d-grid gap-2">
                <a href="/Admin/ThemSanPham" class="btn btn-outline-primary text-start">
                    ➕ Thêm Món Nước Mới
                </a>
                <a href="/Admin/QuanLyDanhMuc" class="btn btn-outline-secondary text-start">
                    📁 Thêm Danh Mục Mới
                </a>
                <a href="/Admin/ThemVoucher" class="btn btn-outline-success text-start">
                    🏷️ Tạo Mã Giảm Giá Mới
                </a>
                <a href="/Admin/ThemNhanVien" class="btn btn-outline-dark text-start">
                    👤 Phân Quyền Nhân Sự Mới
                </a>
            </div>
        </div>
    </div>
</div>
