@model QL_WebBanTraSua.Models.product
@{
    ViewBag.Title = "Thêm Món Nước Mới - TeaBloom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">➕ Thêm Món Nước Mới</h3>
        <p class="text-muted small mb-0">Tạo món nước mới và cấu hình bảng giá tương ứng cho các Size S, M, L</p>
    </div>
    <div>
        <a href="/Admin/QuanLySanPham" class="btn btn-outline-secondary">
            &larr; Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Chi Tiết Món Nước</div>
            <div class="card-body p-4">
                <form method="post" action="/Admin/ThemSanPham" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên món nước <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Trà Sữa Oolong Nướng..." value="@(Model != null ? Model.name : "")" />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                        @Html.DropDownList("category_id", (SelectList)ViewBag.Categories, "-- Chọn danh mục --", new { @class = "form-select", @required = "required" })
                        @Html.ValidationMessage("category_id", "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình ảnh đại diện</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <div class="form-text">Tải lên tệp ảnh từ máy tính (JPG, PNG, WEBP)</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hoặc Đường dẫn ảnh (URL / Tên file ảnh có sẵn)</label>
                        <input type="text" name="image" class="form-control" placeholder="Ví dụ: products/tra_sua_matcha.jpg" value="@(Model != null ? Model.image : "")" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Mô tả hương vị & đặc điểm</label>
                        <textarea name="description" rows="3" class="form-control" placeholder="Mô tả ngắn gọn về hương vị, thành phần đặc sắc...">@(Model != null ? Model.description : "")</textarea>
                    </div>

                    <!-- Cấu hình bảng giá theo Size -->
                    <div class="card bg-light border p-3 mb-4 rounded-3">
                        <h6 class="fw-bold mb-3 text-primary">💰 Thiết Lập Bảng Giá Cho Các Size (VNĐ)</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Giá Size S (Nhỏ)</label>
                                <div class="input-group">
                                    <input type="number" name="priceS" class="form-control" placeholder="25000" min="0" step="1000" value="25000" />
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Giá Size M (Vừa)</label>
                                <div class="input-group">
                                    <input type="number" name="priceM" class="form-control" placeholder="30000" min="0" step="1000" value="30000" />
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Giá Size L (Lớn)</label>
                                <div class="input-group">
                                    <input type="number" name="priceL" class="form-control" placeholder="35000" min="0" step="1000" value="35000" />
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                        </div>
                        <small class="text-muted mt-2 d-block">* Để trống hoặc điền 0 nếu món không hỗ trợ size tương ứng.</small>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_active" value="true" checked id="isActiveSwitch">
                            <input type="hidden" name="is_active" value="false" />
                            <label class="form-check-label fw-bold" for="isActiveSwitch">Kích hoạt mở bán ngay trên menu</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Admin/QuanLySanPham" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            Lưu Món Nước
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
