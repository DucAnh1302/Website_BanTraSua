@model List<QL_WebBanTraSua.Models.order>
@{
    ViewBag.Title = "Tiếp nhận Đơn Online";
    Layout = "~/Views/Shared/_LayoutPos.cshtml";
    string status = ViewBag.Status as string ?? "";
    string search = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1">🛵 Tiếp Nhận &amp; Xử Lý Đơn Đặt Hàng Online</h3>
        <p class="text-muted small mb-0">Nhân viên quầy POS xác nhận pha chế, chuyển giao hàng, hoàn tất hoặc hủy đơn hoàn kho</p>
    </div>
    <a href="/Pos/Index" class="btn btn-primary btn-sm">&larr; Về Bán hàng POS</a>
</div>

<div class="card-pos p-3 mb-3">
    <form method="get" action="/Pos/DonOnline" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Tìm theo mã đơn (#30), tên khách hoặc SĐT..." />
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="pending" @(status == "pending" ? "selected" : "")>Chờ duyệt (pending)</option>
                <option value="preparing" @(status == "preparing" ? "selected" : "")>Đang pha chế (preparing)</option>
                <option value="shipping" @(status == "shipping" ? "selected" : "")>Đang giao hàng (shipping)</option>
                <option value="completed" @(status == "completed" ? "selected" : "")>Hoàn thành (completed)</option>
                <option value="cancelled" @(status == "cancelled" ? "selected" : "")>Đã hủy (cancelled)</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-semibold">Lọc đơn</button>
            <a href="/Pos/DonOnline" class="btn btn-sm btn-outline-secondary">Xóa lọc</a>
        </div>
    </form>
</div>

<div class="card-pos overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Thời gian đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái đơn</th>
                    <th class="text-end pe-3">Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không có đơn hàng Online nào khớp bộ lọc.</td>
                    </tr>
                }
                else
                {
                    foreach (var o in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">#@o.id</td>
                            <td>
                                <div class="fw-semibold">@(o.shipping_name ?? (o.user != null ? o.user.name : "Khách hàng"))</div>
                                <small class="text-muted">@o.shipping_phone</small>
                            </td>
                            <td class="small text-muted">@(o.created_at.HasValue ? o.created_at.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                            <td class="fw-bold text-danger">@string.Format("{0:N0}đ", o.final_total)</td>
                            <td>
                                <span class="badge @(o.payment_status == "paid" ? "bg-success" : "bg-secondary")">
                                    @(o.payment_method == "transfer" ? "VietQR" : "COD") - @(o.payment_status == "paid" ? "Đã thu" : "Chưa thu")
                                </span>
                            </td>
                            <td>
                                @if (o.order_status == "pending")
                                {
                                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                }
                                else if (o.order_status == "preparing")
                                {
                                    <span class="badge bg-info text-dark">Đang pha chế</span>
                                }
                                else if (o.order_status == "shipping")
                                {
                                    <span class="badge bg-primary">Đang giao hàng</span>
                                }
                                else if (o.order_status == "completed")
                                {
                                    <span class="badge bg-success">Hoàn thành</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a href="/Pos/ChiTietDonOnline/@o.id" class="btn btn-sm btn-outline-primary fw-semibold">Xem &amp; Duyệt đơn</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
