@using QL_WebBanTraSua.Models
@{
    var prod = ViewBag.SelectedProduct as product;
    var toppings = ViewBag.Toppings as List<topping> ?? new List<topping>();
    var outOfStockVariants = ViewBag.OutOfStockVariants as HashSet<long> ?? new HashSet<long>();
    var outOfStockToppings = ViewBag.OutOfStockToppings as HashSet<long> ?? new HashSet<long>();
    string search = ViewBag.Search as string ?? "";
    long? currentCat = ViewBag.CategoryId as long?;
}

@if (prod != null)
{
    var variants = prod.product_variants != null ? prod.product_variants.OrderBy(v => v.price).ToList() : new List<product_variants>();
    <div class="card-pos border-primary border-2 p-3 mb-3" style="background-color: #f8fafc;">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
            <h6 class="fw-bold text-primary mb-0">🎛️ Tùy biến ly nước: @prod.name</h6>
            <a href="/Pos/Index?search=@Url.Encode(search)&categoryId=@currentCat" class="btn btn-sm btn-outline-secondary">✕ Đóng</a>
        </div>

        <form method="post" action="/Pos/ThemMonVaoDon">
            @Html.AntiForgeryToken()
            <input type="hidden" name="search" value="@search" />
            <input type="hidden" name="categoryId" value="@currentCat" />

            <div class="mb-3">
                <label class="form-label fw-bold small mb-1">1. Chọn Size ly <span class="text-danger">*</span></label>
                <div class="d-flex flex-wrap gap-3">
                    @{ bool firstChecked = false; }
                    @foreach (var v in variants)
                    {
                        bool vOut = outOfStockVariants.Contains(v.id);
                        bool isChecked = !firstChecked && !vOut;
                        if (isChecked) { firstChecked = true; }

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="variant_id" id="v_@v.id" value="@v.id" @(isChecked ? "checked" : "") @(vOut ? "disabled" : "") required />
                            <label class="form-check-label small fw-semibold" for="v_@v.id">
                                Size @v.size (@string.Format("{0:N0}đ", v.price))
                                @if (vOut)
                                {
                                    <span class="badge bg-danger">Hết NL</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            </div>

            @if (toppings.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label fw-bold small mb-1">2. Thêm Topping</label>
                    <div class="row g-2">
                        @foreach (var tp in toppings)
                        {
                            bool tpOut = outOfStockToppings.Contains(tp.id);
                            <div class="col-sm-6">
                                <div class="form-check bg-white border rounded p-2 ps-4">
                                    <input class="form-check-input" type="checkbox" name="topping_ids" id="tp_@tp.id" value="@tp.id" @(tpOut ? "disabled" : "") />
                                    <label class="form-check-label small" for="tp_@tp.id">
                                        @tp.name (+@string.Format("{0:N0}đ", tp.price))
                                        @if (tpOut)
                                        {
                                            <span class="badge bg-danger ms-1">Hết NL</span>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold small mb-1">3. Lượng Đường</label>
                    <select name="sugar_level" class="form-select form-select-sm">
                        <option value="100" selected>100% Đường</option>
                        <option value="70">70% Đường</option>
                        <option value="50">50% Đường</option>
                        <option value="30">30% Đường</option>
                        <option value="0">0% (Không đường)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small mb-1">4. Mức Đá</label>
                    <select name="ice_option" class="form-select form-select-sm">
                        <option value="normal" selected>Đá bình thường</option>
                        <option value="less">Ít đá (50%)</option>
                        <option value="none">Không đá (0%)</option>
                        <option value="separate">Để đá riêng</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small mb-1">5. Số lượng</label>
                    <input type="number" name="quantity" value="1" min="1" max="50" class="form-control form-control-sm" required />
                </div>
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-bold small mb-1">Ghi chú pha chế</label>
                    <input type="text" name="note" class="form-control form-control-sm" placeholder="VD: Ít trân châu, nhiều bọt sữa..." />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold py-2">
                        ➕ Thêm Vào Đơn POS
                    </button>
                </div>
            </div>
        </form>
    </div>
}
