@{
    Layout = null;
    string userEmail = ViewBag.UserEmail as string ?? "";
    string userName = ViewBag.UserName as string ?? "";
    string userRole = ViewBag.UserRole as string ?? "";
    string otpCodeTest = ViewBag.OtpCodeTest as string ?? "";
    DateTime? expiresAt = ViewBag.OtpExpiresAt as DateTime?;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác thực OTP 2FA - TeaBloom</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            color: #1e293b;
        }
        .auth-topbar {
            background: rgba(15, 23, 42, 0.9);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 14px 32px;
        }
        .auth-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
        }
        .otp-input {
            letter-spacing: 10px;
            font-size: 1.8rem;
            font-weight: 700;
            text-align: center;
            color: #0f766e;
            border: 2px solid #0f766e;
        }
    </style>
</head>
<body>
    <div class="auth-topbar d-flex justify-content-between align-items-center">
        <a href="/Customer/Index" class="text-decoration-none fw-bold fs-4 text-info">
            🧋 TeaBloom Security (2FA)
        </a>
        <a href="/Account/DangNhap" class="btn btn-sm btn-outline-light">Quay lại Đăng nhập</a>
    </div>

    <div class="container-fluid px-4 py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">
                <div class="auth-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="fs-1 mb-2">🛡️</div>
                        <h3 class="fw-bold mb-1">Xác Thực 2 Bước (OTP)</h3>
                        <p class="text-muted small mb-0">
                            Bắt buộc đối với tài khoản nội bộ: <strong>@userName</strong> (<code>@userEmail</code> - Vai trò: <span class="badge bg-dark">@userRole.ToUpper()</span>)
                        </p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success small">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger small">@TempData["Error"]</div>
                    }

                    @if (!string.IsNullOrEmpty(otpCodeTest))
                    {
                        <div class="alert alert-info border border-info text-center mb-4">
                            <div class="small fw-semibold mb-1">💡 Mã OTP thử nghiệm của phiên này:</div>
                            <div class="fs-2 fw-bolder text-primary" style="letter-spacing: 6px;">@otpCodeTest</div>
                            @if (expiresAt.HasValue)
                            {
                                <div class="small text-muted mt-1">Hiệu lực đến @expiresAt.Value.ToString("HH:mm:ss") (10 phút, dùng 1 lần)</div>
                            }
                        </div>
                    }

                    <form method="post" action="/Account/XacThucOtp">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label class="form-label fw-bold text-center d-block">Nhập mã OTP (6 chữ số)</label>
                            <input type="text" name="code" maxlength="6" class="form-control form-control-lg otp-input" required autofocus placeholder="••••••" />
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold mb-3">
                            ✓ Xác Minh OTP &amp; Đăng Nhập
                        </button>
                    </form>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <form method="post" action="/Account/GuiLaiOtp" class="mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link p-0 text-decoration-none fw-semibold small">
                                🔄 Gửi lại mã OTP mới
                            </button>
                        </form>
                        <a href="/Account/DangNhap" class="small text-danger text-decoration-none fw-semibold">Hủy bỏ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
