@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký Khách hàng - TeaBloom</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            color: #1e293b;
        }
        .auth-topbar {
            background: rgba(15, 23, 42, 0.9);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 14px 32px;
        }
        .auth-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
        }
    </style>
</head>
<body>
    <div class="auth-topbar d-flex justify-content-between align-items-center">
        <a href="/Customer/Index" class="text-decoration-none fw-bold fs-4 text-info">
            🧋 TeaBloom Milk Tea
        </a>
        <div class="d-flex gap-2">
            <a href="/Customer/Index" class="btn btn-sm btn-outline-light">Về trang khách hàng</a>
            <a href="/Account/DangNhap" class="btn btn-sm btn-info fw-semibold text-dark">Đăng nhập</a>
        </div>
    </div>

    <div class="container-fluid px-4 py-5">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                <div class="auth-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="fs-1 mb-2">🌸</div>
                        <h3 class="fw-bold mb-1">Đăng Ký Thành Viên</h3>
                        <p class="text-muted small mb-0">Tạo tài khoản khách hàng TeaBloom để tích điểm &amp; nhận ưu đãi</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger small">@TempData["Error"]</div>
                    }

                    <form method="post" action="/Account/DangKy">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="name" value="@ViewBag.InputName" class="form-control" required placeholder="Nguyễn Văn A" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" value="@ViewBag.InputEmail" class="form-control" required placeholder="khachhang@gmail.com" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="text" name="phone" value="@ViewBag.InputPhone" class="form-control" placeholder="0901234567" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mật khẩu (tối thiểu 6 ký tự) <span class="text-danger">*</span></label>
                            <input type="password" name="password" class="form-control" required placeholder="••••••••" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" name="confirm_password" class="form-control" required placeholder="••••••••" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold mb-3">
                            Tạo Tài Khoản Khách Hàng
                        </button>

                        <div class="text-center small text-muted">
                            Đã có tài khoản?
                            <a href="/Account/DangNhap" class="fw-bold text-decoration-none">Đăng nhập ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
