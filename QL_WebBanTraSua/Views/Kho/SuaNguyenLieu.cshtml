@using QL_WebBanTraSua.Models
@model ingredient
@{
    ViewBag.Title = "Sửa nguyên liệu";
    Layout = "~/Views/Shared/_LayoutKho.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">✏️ Sửa Nguyên Liệu</h3>
        <p class="text-muted small mb-0">Muốn đổi số lượng tồn, hãy lập phiếu nhập hoặc phiếu xuất để lưu lại lịch sử.</p>
    </div>
    <div>
        <a href="/Kho/Index" class="btn btn-outline-secondary">&larr; Quay lại kho</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card-custom">
            <div class="card-header fw-bold">Thông Tin Nguyên Liệu #@Model.id</div>
            <div class="card-body p-4">
                <form method="post" action="/Kho/SuaNguyenLieu">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên nguyên liệu <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" value="@Model.name" required />
                        @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                            <input type="text" name="unit" class="form-control" value="@Model.unit" required />
                            @Html.ValidationMessage("unit", "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nhóm sử dụng</label>
                            <select name="consumption_role" class="form-select">
                                <option value="normal" @(Model.consumption_role == "normal" ? "selected" : "")>Thông thường (Món nước)</option>
                                <option value="topping" @(Model.consumption_role == "topping" ? "selected" : "")>Dùng cho Topping</option>
                                <option value="packaging" @(Model.consumption_role == "packaging" ? "selected" : "")>Bao bì / Ly / Ống hút</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tồn hiện tại</label>
                            <input type="text" class="form-control" value="@string.Format("{0:N1}", Model.stock_quantity) @Model.unit" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngưỡng cảnh báo sắp hết</label>
                            <input type="number" name="min_stock" class="form-control" value="@Model.min_stock" step="any" min="0" />
                            @Html.ValidationMessage("min_stock", "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">💾 Lưu Thay Đổi</button>
                        <a href="/Kho/Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
