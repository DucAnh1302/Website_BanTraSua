<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "TIỆM TRÀ SỮA") - ĐẬM VỊ TRÀ, THƠM VỊ SỮA</title>

    <!-- Google Font Montserrat hỗ trợ tiếng Việt chuẩn -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <!-- CSS Frameworks & Theme (Dùng milktea.css chuẩn, không dùng styles.css để tránh xung đột) -->
    <link rel="stylesheet" href="@Url.Content("~/assets/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/assets/css/milktea.css")" />

    <style>
        body {
            font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        }
        .cart-count-badge {
            font-size: 0.65rem;
        }
        .navbar-brand {
            letter-spacing: 2px;
        }
        .product-card {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12) !important;
        }
        .option-pill {
            cursor: pointer;
            border-radius: 50rem;
            padding: 0.45rem 1.1rem;
            font-weight: 500;
        }
        .btn-check:checked + .option-pill {
            background-color: #df6743 !important;
            color: #ffffff !important;
            border-color: #df6743 !important;
        }
        .topping-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 14px;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>
    <!-- HEADER & NAVBAR -->
    <header class="main-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-black py-3">
            <div class="container-fluid px-4 px-xl-5 position-relative d-flex justify-content-between align-items-center">
                <!-- Cụm Trái: Logo -->
                <a class="navbar-brand text-white fw-bolder text-uppercase m-0"
                   href="@Url.Action("Index", "Customer")"
                   style="font-size: 1.5rem; letter-spacing: 2px;">
                    TIỆM TRÀ SỮA
                </a>

                <!-- Hamburger Button -->
                <button class="navbar-toggler border-0 shadow-none text-white px-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#teaNavbar">
                    <i class="bi bi-list fs-1"></i>
                </button>

                <!-- Cụm Giữa: Navigation -->
                <div class="collapse navbar-collapse navbar-center-absolute mobile-nav-bg" id="teaNavbar">
                    <ul class="navbar-nav mb-2 mb-lg-0 fw-semibold text-uppercase text-center gap-lg-2 gap-xl-4 mt-4 mt-lg-0"
                        style="font-size: 0.85rem; letter-spacing: 1.5px;">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="@Url.Action("Index", "Customer")">TRANG CHỦ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="@Url.Action("Products", "Customer")">THỰC ĐƠN</a>
                        </li>

                        <!-- Dropdown Menu Khám Phá -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white"
                               href="#"
                               id="menuDropdown"
                               role="button"
                               data-bs-toggle="dropdown">KHÁM PHÁ</a>
                            <ul class="dropdown-menu dropdown-menu-dark border-secondary rounded-0 shadow-sm text-center text-lg-start">
                                <li><a class="dropdown-item py-2" href="@Url.Action("Products", "Customer", new { categoryId = 1 })">Trà Sữa</a></li>
                                <li><a class="dropdown-item py-2" href="@Url.Action("Products", "Customer", new { categoryId = 2 })">Trà Trái Cây</a></li>
                                <li><a class="dropdown-item py-2" href="@Url.Action("Products", "Customer", new { categoryId = 3 })">Cà Phê</a></li>
                                <li><a class="dropdown-item py-2" href="@Url.Action("Products", "Customer", new { categoryId = 4 })">Đá Xay</a></li>
                                <li><a class="dropdown-item py-2" href="@Url.Action("Products", "Customer", new { categoryId = 5 })">Matcha</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" href="@Url.Action("About", "Customer")">VỀ CHÚNG TÔI</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="@Url.Action("Tips", "Customer")">CẨM NANG</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="@Url.Action("Contact", "Customer")">LIÊN HỆ</a>
                        </li>
                    </ul>
                </div>

                <!-- Cụm Phải: Icons -->
                <div class="header-icons d-flex align-items-center gap-3 gap-lg-4">
                    <a href="#"
                       class="text-white text-decoration-none icon-link-hover"
                       title="Tìm kiếm"
                       data-bs-toggle="modal"
                       data-bs-target="#searchModal">
                        <i class="bi bi-search fs-5"></i>
                    </a>

                    <div class="nav-item dropdown d-inline-block">
                        <a href="#"
                           class="text-white text-decoration-none icon-link-hover"
                           id="userDropdown"
                           role="button"
                           data-bs-toggle="dropdown">
                            <i class="bi bi-person fs-5"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary rounded-0 shadow-sm">
                            <li>
                                <a class="dropdown-item py-2" href="@Url.Action("OrderHistory", "Customer")">
                                    <i class="bi bi-clock-history me-2"></i>Lịch sử đơn hàng
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="@Url.Action("Cart", "Customer")">
                                    <i class="bi bi-bag me-2"></i>Giỏ hàng của tôi
                                </a>
                            </li>
                        </ul>
                    </div>

                    @{
                        var cart = Session["GioHang_Session"] as List<QL_WebBanTraSua.Models.CartItem>;
                        int cartCount = cart != null ? cart.Sum(i => i.Quantity) : 0;
                    }
                    <a href="@Url.Action("Cart", "Customer")"
                       class="text-white text-decoration-none position-relative icon-link-hover"
                       title="Giỏ hàng">
                        <i class="bi bi-bag fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-dark cart-count-badge">
                            @cartCount
                        </span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN BODY -->
    @RenderBody()

    <!-- FOOTER CHUYÊN BIỆT CHO F&B -->
    <footer class="footer bg-dark text-light py-5 mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <h4 class="text-white fw-bold mb-3">TIỆM TRÀ SỮA</h4>
                    <p class="text-secondary small mb-3">
                        Đậm vị trà, Thơm vị sữa. Chuyên cung cấp các loại thức uống tươi
                        ngon, an toàn vệ sinh với công thức độc quyền.
                    </p>
                    <ul class="list-unstyled text-secondary small">
                        <li class="mb-2">
                            <i class="bi bi-geo-alt me-2"></i>140 Lê Trọng Tấn, Tân Phú, TP.HCM
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-telephone me-2"></i>1900 1234
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope me-2"></i>cskh@trasua.vn
                        </li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h5 class="text-white fw-semibold mb-3">Hỗ Trợ Khách Hàng</h5>
                    <ul class="list-unstyled footer-links">
                        <li class="mb-2">
                            <a href="@Url.Action("Products", "Customer")" class="text-secondary text-decoration-none">Thực đơn thức uống</a>
                        </li>
                        <li class="mb-2">
                            <a href="@Url.Action("OrderHistory", "Customer")" class="text-secondary text-decoration-none">Lịch sử & Xuất hóa đơn</a>
                        </li>
                        <li class="mb-2">
                            <a href="@Url.Action("About", "Customer")" class="text-secondary text-decoration-none">Về Tiệm Trà Sữa</a>
                        </li>
                        <li class="mb-2">
                            <a href="@Url.Action("Contact", "Customer")" class="text-secondary text-decoration-none">Liên hệ cửa hàng</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h5 class="text-white fw-semibold mb-3">Nhận Ưu Đãi</h5>
                    <p class="text-secondary small mb-3">
                        Đăng ký email để nhận mã giảm giá và ưu đãi mới nhất cho các món trà sữa.
                    </p>
                    <div class="d-flex">
                        <input type="email"
                               class="form-control form-control-sm rounded-start-pill border-0 px-3"
                               placeholder="Nhập email..." />
                        <button class="btn btn-primary btn-sm rounded-end-pill fw-bold px-4"
                                type="button">
                            GỬI
                        </button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary opacity-25" />
            <div class="text-center text-secondary small pt-3">
                &copy; 2026 TIỆM TRÀ SỮA. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Search Modal -->
    <div class="modal fade" id="searchModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white rounded-4 border-secondary">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title fw-bold">Tìm Kiếm Thức Uống</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form action="@Url.Action("Products", "Customer")" method="GET" class="d-flex">
                        <input type="text"
                               name="search"
                               class="form-control rounded-pill rounded-end-0 bg-black text-white border-secondary shadow-none px-3"
                               placeholder="Nhập tên thức uống cần tìm..."
                               required />
                        <button type="submit"
                                class="btn btn-primary rounded-pill rounded-start-0 fw-bold px-4">
                            TÌM
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="@Url.Content("~/assets/js/bootstrap.bundle.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
